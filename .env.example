# Clave de la API de Gemini para el chatbot.
# Se saca gratis en https://aistudio.google.com/apikey (no pide tarjeta).
GEMINI_API_KEY=

# Opcional. Por defecto gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.7-flash

# Opcional. Por defecto MINIMAL, que es lo que acepta flash-lite.
# Si ponés GEMINI_MODEL=gemini-3.7-flash tenés que subirlo a LOW: ese modelo
# rechaza MINIMAL con un 400.
# GEMINI_THINKING_LEVEL=LOW

# Opcional. URL canónica del sitio para metadata, sitemap y OG.
# NEXT_PUBLIC_SITE_URL=
